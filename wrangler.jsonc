// Cloudflare Workers (static assets only, no server code). Deploys on every push to GitHub main.
{
  "name": "satyam-onecrest-kharghar",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "onecrest-kharghar.com", "custom_domain": true }],
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
